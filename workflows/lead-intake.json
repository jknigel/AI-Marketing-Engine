{
  "name": "Lead Intake",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "wh1", "name": "Lead Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 1.1, "position": [0, 0],
      "parameters": { "httpMethod": "POST", "path": "lead-intake", "responseMode": "onReceived" }
    },
    {
      "id": "norm1", "name": "Normalize", "type": "n8n-nodes-base.set", "typeVersion": 3.2, "position": [220, 0],
      "parameters": {
        "assignments": { "assignments": [
          { "id": "a1", "name": "email", "type": "string", "value": "={{ ($json.body.email || '').toLowerCase().trim() }}" },
          { "id": "a2", "name": "name", "type": "string", "value": "={{ $json.body.name || '' }}" },
          { "id": "a3", "name": "source", "type": "string", "value": "={{ $json.body.utm_source || $json.body.source || 'unknown' }}" },
          { "id": "a4", "name": "campaign", "type": "string", "value": "={{ $json.body.utm_campaign || '' }}" }
        ] }
      }
    },
    {
      "id": "crm1", "name": "Upsert to HubSpot", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [440, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { email: $json.email, firstname: $json.name, hs_lead_status: 'NEW', utm_source: $json.source, utm_campaign: $json.campaign } }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "notify1", "name": "Notify Slack", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [660, 0],
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.SLACK_BOT_TOKEN }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: '#marketing', text: '🆕 New lead: ' + $('Normalize').item.json.email + ' (source: ' + $('Normalize').item.json.source + ')' }) }}"
      }
    }
  ],
  "connections": {
    "Lead Webhook": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Upsert to HubSpot", "type": "main", "index": 0 }]] },
    "Upsert to HubSpot": { "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]] }
  }
}
