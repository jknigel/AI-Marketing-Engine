############################################################
# AI MARKETING ENGINE — MASTER ENV
#
# This is the ONLY place keys live. Copy to `.env`:
#   cp .env.example .env
# The setup wizard (http://localhost:3000) fills in and
# validates only the keys required by the profiles you enable.
# Keys marked [optional] degrade gracefully when absent.
############################################################

############################################
# 0. ENGINE CORE
############################################
ENGINE_NAME=my-marketing-engine
ENGINE_TIMEZONE=UTC
ENGINE_MODE=setup                # setup | run  (flipped by the wizard)
UI_PORT=3000
ENGINE_AUTH_PASSWORD=            # protects the web UI (set at setup)
ENGINE_WEBHOOK_SECRET=           # shared secret for n8n <-> engine calls (generated at setup); NEVER given to agents
ENGINE_AGENT_TOKEN=              # auth token for Hermes profiles -> engine API, e.g. /api/publish (generated at setup)

############################################
# 0b. SAFETY / SPEND GUARDRAILS
############################################
SPEND_CAP_DAILY_USD=100          # hard cap across all ad platforms
SPEND_CAP_MONTHLY_USD=2000
APPROVAL_MODE=manual             # manual | auto  (auto can be set per-channel in workspace/config.json)

############################################
# 1. LLM / AGENT RUNTIME
############################################
ANTHROPIC_API_KEY=               # everything-claude-code OS layer + default Hermes model
HERMES_MODEL=anthropic/claude-opus-4-8   # default model for all profiles (per-profile override in frontmatter)
OPENROUTER_API_KEY=              # [optional] model routing/fallback for Hermes
OPENAI_API_KEY=                  # [optional] embeddings / alt models

############################################
# 2. SEARCH & RESEARCH
############################################
TAVILY_API_KEY=                  # web research
SERPER_API_KEY=                  # SERP data
FIRECRAWL_API_KEY=               # site crawling (brand import, competitor teardowns)
PERPLEXITY_API_KEY=              # [optional] deep research

############################################
# 3. SEO
############################################
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=   # path to service-account JSON, or inline JSON
AHREFS_API_KEY=                  # [optional]
SEMRUSH_API_KEY=                 # [optional]

############################################
# 4. ANALYTICS & ATTRIBUTION
############################################
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS=    # path to service-account JSON
POSTHOG_API_KEY=                 # [optional]
MIXPANEL_TOKEN=                  # [optional]

############################################
# 5. PAID ADS
############################################
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
LINKEDIN_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=   # [optional] Bing
X_ADS_API_KEY=                   # [optional]

############################################
# 6. ORGANIC SOCIAL
############################################
BUFFER_ACCESS_TOKEN=             # scheduling golden path; or use native APIs below
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=          # FB Page + Instagram
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

############################################
# 7. EMAIL / SMS / MESSAGING
############################################
RESEND_API_KEY=                  # ESP golden path
SENDGRID_API_KEY=                # [optional] alternative ESP
MAILCHIMP_API_KEY=               # [optional]
KLAVIYO_API_KEY=                 # [optional] e-commerce ESP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_BUSINESS_TOKEN=

############################################
# 8. CRM & SALES
############################################
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=            # [optional]
SALESFORCE_CLIENT_SECRET=        # [optional]
PIPEDRIVE_API_TOKEN=             # [optional]
APOLLO_API_KEY=                  # prospecting / ABM data
CLEARBIT_API_KEY=                # [optional] enrichment

############################################
# 9. CREATIVE / MEDIA GENERATION
############################################
FAL_API_KEY=                     # image gen — golden path (FLUX via fal.ai)
REPLICATE_API_TOKEN=             # [optional] image/video gen
ELEVENLABS_API_KEY=              # [optional] voice/audio
CANVA_API_KEY=                   # [optional] templated design
UNSPLASH_ACCESS_KEY=             # [optional] stock fallback

############################################
# 10. COMMERCE & REVIEWS
############################################
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
AMAZON_ADS_CLIENT_ID=            # [optional]
TRUSTPILOT_API_KEY=              # [optional]
G2_API_KEY=                      # [optional]

############################################
# 11. AUTOMATION & INFRA
############################################
# n8n (bundled service — set by the setup wizard)
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=              # generated at setup; encrypts stored credentials
N8N_API_KEY=                     # engine -> n8n API access (trigger/deploy workflows)
N8N_BASE_URL=http://n8n:5678     # internal compose hostname
ZAPIER_WEBHOOK_URL=              # [optional] external automation
SLACK_BOT_TOKEN=                 # notifications/approvals in Slack
DISCORD_BOT_TOKEN=               # community profile
GITHUB_TOKEN=                    # opencode: landing page repos, deploys
VERCEL_TOKEN=                    # [optional] landing page hosting
CLOUDFLARE_API_TOKEN=            # [optional]
