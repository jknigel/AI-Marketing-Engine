############################################################
# AI MARKETING ENGINE — MASTER ENV
#
# This is the ONLY place keys live. Copy to `.env`:
#   cp .env.example .env
#
# You can leave every key blank here — the engine boots straight to its
# dashboard and you fill in keys, capabilities, brand and goals in the UI
# at http://localhost:3000/settings (validated live where possible).
# Keys marked [optional] degrade gracefully when absent.
#
# IMPORTANT: keep comments on their OWN lines. A trailing "KEY=value # note"
# is parsed as part of the value by some tools — always comment above the key.
############################################################

############################################
# 0. ENGINE CORE
############################################
ENGINE_NAME=my-marketing-engine
ENGINE_TIMEZONE=UTC
# engine is usable immediately; configure everything at /settings
ENGINE_MODE=run
UI_PORT=3000
# [optional] protects the web UI; set it in Settings to require a password
ENGINE_AUTH_PASSWORD=
# shared secret for n8n <-> engine calls (auto-generated on first save); NEVER given to agents
ENGINE_WEBHOOK_SECRET=
# auth token for Hermes profiles -> engine API, e.g. /api/publish (auto-generated on first save)
ENGINE_AGENT_TOKEN=

############################################
# 0b. SAFETY / SPEND GUARDRAILS
############################################
# hard cap across all ad platforms
SPEND_CAP_DAILY_USD=100
SPEND_CAP_MONTHLY_USD=2000
# manual | auto  (auto can be set per-channel in workspace/config.json)
APPROVAL_MODE=manual

############################################
# 1. LLM / AGENT RUNTIME
############################################
# The engine runs on ONE LLM provider — pick Anthropic, OpenAI or DeepSeek in
# Settings. HERMES_MODEL selects provider + model as "provider/model"; set the
# matching provider key below. You only need the key for the provider you use.
#
# Anthropic  -> HERMES_MODEL=anthropic/claude-opus-4-8   (set ANTHROPIC_API_KEY)
# OpenAI     -> HERMES_MODEL=openai/gpt-4o                (set OPENAI_API_KEY)
# DeepSeek   -> HERMES_MODEL=deepseek/deepseek-chat       (set DEEPSEEK_API_KEY)
HERMES_MODEL=anthropic/claude-opus-4-8
# Anthropic (Claude) — default provider
ANTHROPIC_API_KEY=
# OpenAI (GPT)
OPENAI_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# [optional] model routing/fallback for Hermes
OPENROUTER_API_KEY=

############################################
# 2. SEARCH & RESEARCH
############################################
# web research
TAVILY_API_KEY=
# SERP data
SERPER_API_KEY=
# site crawling (brand import, competitor teardowns)
FIRECRAWL_API_KEY=
# [optional] deep research
PERPLEXITY_API_KEY=

############################################
# 3. SEO
############################################
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# path to service-account JSON, or inline JSON
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# [optional]
AHREFS_API_KEY=
# [optional]
SEMRUSH_API_KEY=

############################################
# 4. ANALYTICS & ATTRIBUTION
############################################
GA4_PROPERTY_ID=
# path to service-account JSON
GOOGLE_ANALYTICS_CREDENTIALS=
# [optional]
POSTHOG_API_KEY=
# [optional]
MIXPANEL_TOKEN=

############################################
# 5. PAID ADS
############################################
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
LINKEDIN_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
# [optional] Bing
MICROSOFT_ADS_DEVELOPER_TOKEN=
# [optional]
X_ADS_API_KEY=

############################################
# 6. ORGANIC SOCIAL
############################################
# scheduling golden path; or use native APIs below
BUFFER_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
# FB Page + Instagram
META_PAGE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

############################################
# 7. EMAIL / SMS / MESSAGING
############################################
# ESP golden path
RESEND_API_KEY=
# [optional] alternative ESP
SENDGRID_API_KEY=
# [optional]
MAILCHIMP_API_KEY=
# [optional] e-commerce ESP
KLAVIYO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_BUSINESS_TOKEN=

############################################
# 8. CRM & SALES
############################################
HUBSPOT_ACCESS_TOKEN=
# [optional]
SALESFORCE_CLIENT_ID=
# [optional]
SALESFORCE_CLIENT_SECRET=
# [optional]
PIPEDRIVE_API_TOKEN=
# prospecting / ABM data
APOLLO_API_KEY=
# [optional] enrichment
CLEARBIT_API_KEY=

############################################
# 9. CREATIVE / MEDIA GENERATION
############################################
# image gen — golden path (FLUX via fal.ai)
FAL_API_KEY=
# [optional] image/video gen
REPLICATE_API_TOKEN=
# [optional] voice/audio
ELEVENLABS_API_KEY=
# [optional] templated design
CANVA_API_KEY=
# [optional] stock fallback
UNSPLASH_ACCESS_KEY=

############################################
# 10. COMMERCE & REVIEWS
############################################
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
# [optional]
AMAZON_ADS_CLIENT_ID=
# [optional]
TRUSTPILOT_API_KEY=
# [optional]
G2_API_KEY=

############################################
# 11. AUTOMATION & INFRA
############################################
# n8n (bundled service — set by the setup wizard)
N8N_USER=admin
N8N_PASSWORD=
# generated at setup; encrypts stored credentials
N8N_ENCRYPTION_KEY=
# engine -> n8n API access (trigger/deploy workflows)
N8N_API_KEY=
# internal compose hostname
N8N_BASE_URL=http://n8n:5678
# [optional] external automation
ZAPIER_WEBHOOK_URL=
# notifications/approvals in Slack
SLACK_BOT_TOKEN=
# community profile
DISCORD_BOT_TOKEN=
# opencode: landing page repos, deploys
GITHUB_TOKEN=
# [optional] landing page hosting
VERCEL_TOKEN=
# [optional]
CLOUDFLARE_API_TOKEN=
