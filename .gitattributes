# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts (they run in Linux containers).
*.sh text eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
